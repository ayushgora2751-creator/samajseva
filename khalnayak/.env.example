# Django Settings
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database (Leave blank for default SQLite in local development)
DATABASE_URL=postgres://user:password@hostname:5432/bingo_arena

# Real-time WebSockets / Redis (Leave blank for in-memory channel layer in local development)
REDIS_URL=redis://default:password@hostname:6379

# Frontend URL for CORS in production
FRONTEND_URL=https://bingo-arena.vercel.app

